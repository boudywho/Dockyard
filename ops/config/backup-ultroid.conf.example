# Exact legacy-layout backup example. Install root:root 0600 as
# /etc/dockyard/backup.conf and provision the recipient/key values separately.
AGE_RECIPIENT=
AGE_IDENTITY_FILE=/root/.config/age/dockyard-restore.agekey
HMAC_KEY_FILE=/etc/dockyard/backup-auth.key
BACKUP_DIR=/var/backups/dockyard
ALLOWLIST_FILE=/etc/dockyard/backup-paths-ultroid
REDIS_ENV_FILE=/etc/dockyard/redis.env
BACKUP_MODE=legacy
LEGACY_SOURCE=/opt/ultroid
DOCKYARD_OPS_HELPER=/usr/local/lib/dockyard/dockyard_ops.py
QUIESCE_SERVICE=ultroid.service
DOCKYARD_STATUS_GROUP=ultroid
DOCKYARD_STATUS_DIR=/var/lib/dockyard/status
