# Install root:root 0600 as /etc/dockyard/backup.conf.
# Public age recipient only; keep the private identity offline.
AGE_RECIPIENT=
AGE_IDENTITY_FILE=/root/.config/age/dockyard-restore.agekey
# Provision at least 32 random bytes before enabling the timer; keep root:root
# 0600 and separate from both the age identity and backup directory.
HMAC_KEY_FILE=/etc/dockyard/backup-auth.key
BACKUP_DIR=/var/backups/dockyard
ALLOWLIST_FILE=/etc/dockyard/backup-paths
REDIS_ENV_FILE=/etc/dockyard/redis.env
BACKUP_MODE=managed
DOCKYARD_OPS_HELPER=/usr/local/lib/dockyard/dockyard_ops.py
DOCKYARD_RUNTIME_ROOT=/var/lib/dockyard/workspaces
DOCKYARD_RUNTIME_LINK=/var/lib/dockyard/current
QUIESCE_SERVICE=dockyard.service
DOCKYARD_STATUS_GROUP=dockyard
DOCKYARD_STATUS_DIR=/var/lib/dockyard/status
