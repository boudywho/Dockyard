# Install root:root 0600 as /etc/dockyard/health.conf.
SERVICE=dockyard.service
READY_FILE=/run/dockyard/ready
READY_MAX_AGE_SECONDS=45
DOCKYARD_STATUS_DIR=/var/lib/dockyard/status
DOCKYARD_STATUS_GROUP=dockyard
RUNTIME_USER=ultroid
RUNTIME_GROUP=ultroid
LAYOUT_MODE=managed
RELEASE_ROOT=/opt/dockyard/releases
WORKSPACE_ROOT=/var/lib/dockyard/workspaces
RUNTIME_LINK=/var/lib/dockyard/current
REDIS_ENV_FILE=/etc/dockyard/redis.env
DISK_PATH=/opt/dockyard
BACKUP_MAX_AGE_SECONDS=129600
UPDATE_MAX_AGE_SECONDS=172800
ALERT_COOLDOWN_SECONDS=3600
# Optional; leave blank to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
