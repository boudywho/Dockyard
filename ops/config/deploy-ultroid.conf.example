# Exact legacy production migration example. Install root:root 0640 as
# /etc/dockyard/deploy.conf and replace only the commit placeholder.
DOCKYARD_RELEASE_TAG=v2.2.2
DOCKYARD_RELEASE_COMMIT=0000000000000000000000000000000000000000
DOCKYARD_RELEASE_ROOT=/opt/dockyard/releases
DOCKYARD_RUNTIME_ROOT=/var/lib/dockyard/workspaces
DOCKYARD_RUNTIME_LINK=/var/lib/dockyard/current
DOCKYARD_RUNTIME_USER=ultroid
DOCKYARD_RUNTIME_GROUP=ultroid
DOCKYARD_STATUS_DIR=/var/lib/dockyard/status
DOCKYARD_APP_STATUS_DIR=/var/lib/dockyard/app-status
DOCKYARD_STATUS_GROUP=ultroid
DOCKYARD_RELEASE_METADATA=/var/lib/dockyard/status/release.json
DOCKYARD_SERVICE=ultroid.service
DOCKYARD_READY_FILE=/run/dockyard/ready
DOCKYARD_READY_MAX_AGE_SECONDS=45
DOCKYARD_KEEP_RELEASES=5
