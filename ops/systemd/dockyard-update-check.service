[Unit]
Description=Check approved Dockyard release availability
After=network-online.target dockyard-paths.service
Wants=network-online.target
Requires=dockyard-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dockyard-deploy check
TimeoutStartSec=45s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/dockyard/status
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
