[Unit]
Description=Dockyard health and alert probe
After=dockyard.service ultroid-redis.service dockyard-paths.service
Requires=dockyard-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dockyard-health
TimeoutStartSec=45s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/dockyard/status
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
