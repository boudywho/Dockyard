[Unit]
Description=Encrypted Dockyard backup
After=redis-server.service dockyard-paths.service
Requires=dockyard-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dockyard-backup
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/dockyard /var/lib/dockyard/status /run/lock/dockyard
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
