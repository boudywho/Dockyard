[Unit]
Description=Dockyard transactional release deployment
After=network-online.target dockyard-paths.service
Wants=network-online.target
Requires=dockyard-paths.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dockyard-deploy deploy --non-interactive
TimeoutStartSec=15min
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/dockyard /var/lib/dockyard /run/dockyard /run/lock/dockyard
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
